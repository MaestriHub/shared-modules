{
  "name": "shared-modules-tooling",
  "version": "0.0.1",
  "description": "OpenAPI split-contract tooling and DTO generation",
  "private": true,
  "keywords": [
    "openapi",
    "dto",
    "tooling"
  ],
  "author": "misha",
  "license": "ISC",
  "scripts": {
    "openapi:lint": "spectral lint \"docs/openapi/split/*-3.2.yaml\"",
    "openapi:lint:all": "spectral lint \"docs/openapi/split/*-3.2.yaml\"",
    "openapi:redocly:lint": "npm run openapi:bundle:docs && redocly lint docs/openapi/dist/maetry-openapi-docs-3.2.yaml",
    "openapi:bundle:docs": "node scripts/bundle_openapi_for_docs.mjs",
    "openapi:docs:preview": "npm run openapi:bundle:docs && redocly preview --product redoc -d docs/openapi/dist -p ${OPENAPI_DOCS_PORT:-18080}",
    "openapi:docs:build": "npm run openapi:bundle:docs && redocly build-docs docs/openapi/dist/maetry-openapi-docs-3.2.yaml -o docs/openapi/dist/maetry-openapi-docs-3.2.html",
    "openapi:diff": "openapi-changes report --no-color",
    "openapi:diff:summary": "openapi-changes summary --no-color",
    "openapi:semver:plan": "node scripts/semver_bump_from_openapi_diff.mjs",
    "openapi:semver:bump": "node scripts/semver_bump_from_openapi_diff.mjs --write",
    "openapi:rebuild": "npm run openapi:bundle:docs",
    "openapi:dto:generate": "./scripts/generate_dtos.sh",
    "openapi:check": "npm run openapi:lint && npm run openapi:bundle:docs",
    "openapi:release:prepare": "npm run openapi:check && npm run openapi:dto:generate"
  },
  "devDependencies": {
    "@pb33f/openapi-changes": "^0.0.93",
    "@redocly/cli": "^2.17.0",
    "@stoplight/spectral-cli": "^6.15.0"
  }
}
